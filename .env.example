# Copy this file to .env and fill in your values.
# .env is loaded by mysite/settings.py via load_dotenv()

# ---------- Cloudinary (for profile/academy images) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- Deployment (Railway sets RAILWAY_PUBLIC_DOMAIN automatically) ----------
# If 400 Bad Request on Railway, set: ALLOWED_HOSTS=your-app.up.railway.app

# ---------- Email (Resend) ----------
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Use onboarding@resend.dev for testing (no verification needed)
# For production, use an email from your verified domain
DEFAULT_FROM_EMAIL=onboarding@resend.dev
# Optional: Logo URL for email templates (must be publicly accessible)
# BRENEO_LOGO_URL=https://your-domain.com/path/to/logo.png

# ---------- Other (examples) ----------
# SECRET_KEY=your-secret-key
# DEBUG=0
